# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to true to run the frontend prototype against local mock API data.
NEXT_PUBLIC_USE_MOCK_API=false

# WebSocket base URL (should match the API host)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Google Analytics measurement ID (leave blank to disable)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Google reCAPTCHA v3 site key (leave blank to disable reCAPTCHA)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
